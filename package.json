{
  "name": "adflow",
  "version": "1.0.0",
  "description": "Two-sided advertising traffic management platform",
  "scripts": {
    "install:server": "cd server && pip install -r requirements.txt",
    "install:client": "cd client && npm install",
    "install:all": "npm run install:server && npm run install:client",
    "dev:server": "cd server && uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "dev:client": "cd client && npm run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "seed": "cd server && python seed_data.py"
  },
  "keywords": ["advertising", "ads", "publishers", "advertisers"],
  "author": "AdFlow Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
